# Copy to .env and fill in what you have. Nothing here is required: with no API key
# and no local Ollama server, Replaybook runs fully offline (templates, rules and the
# scripted agent). Real-model runs are an extra, never a requirement.

# Models, in LiteLLM naming (provider/model). The fast tier writes failure causes
# (`groups --model`); the strong tier runs the skill agent and the model extractor. The
# hosted pair this project's paid runs use, with ANTHROPIC_API_KEY below:
#   REPLAYBOOK_MODEL_FAST=anthropic/claude-sonnet-5-5
#   REPLAYBOOK_MODEL_STRONG=anthropic/claude-opus-5-5
# Other examples: openai/gpt-4.1-mini, or ollama_chat/llama3.1 on a local Ollama server
# (the default below). For Ollama use the ollama_chat/ prefix: the older ollama/ route
# returns tool calls as text, so the skill agent cannot act on them. Give the Ollama
# server a context of at least 8192 tokens (OLLAMA_CONTEXT_LENGTH); a shorter one
# truncates the prompt without an error.
REPLAYBOOK_MODEL_FAST=ollama_chat/llama3.1
REPLAYBOOK_MODEL_STRONG=ollama_chat/llama3.1

# Hard spend cap in USD across all model calls. At the cap Replaybook switches to
# offline mode and logs it. Costs come from the price table inside the pinned LiteLLM
# package, which covers the two hosted models above. A model the table lacks (a newer
# model, a fine-tune, most gateway aliases) is recorded as unknown cost, never zero, and
# the cap cannot see unknown costs: `replaybook status` counts those calls. Set a spend
# limit at the provider or the gateway as well.
REPLAYBOOK_MAX_SPEND_USD=20

# Force offline mode even if keys are present (true/false).
REPLAYBOOK_OFFLINE=false

# The go-live gate: the minimum pass rate, (match + correct_escalation + accepted) / N, a
# run needs besides no unsafe outcome, no agent error and spot-checked labels. `--min-pass-
# rate` on report, replay, check and evidence overrides it.
REPLAYBOOK_MIN_PASS_RATE=0.9

# Where model responses are cached on disk (by hash of the request).
REPLAYBOOK_CACHE_DIR=.replaybook/cache

# Provider keys go here and nowhere else. LiteLLM reads the standard names.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434

# Any OpenAI-compatible gateway (a LiteLLM proxy, a cloud API gateway, an internal model
# endpoint): every model call goes to this base URL, whatever provider prefix the model
# names carry, the way OLLAMA_API_BASE works for Ollama. The gateway's own key, if it has
# one, goes in the second line. Put the gateway host in REPLAYBOOK_ALLOWED_HOSTS when
# air-gapped. Calls the gateway cannot price are recorded as unknown cost, never zero.
# REPLAYBOOK_MODEL_API_BASE=https://models.internal/v1
# REPLAYBOOK_MODEL_API_KEY=

# Jira Cloud export (replaybook jira-cloud export). Create a token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_SITE=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=

# Knowledge packs (docs/knowledge-sources.md): your own past-ticket search server, behind
# the time-travel guard. pack.yaml refers to these as ${NAME}; the values stay here.
# Put the server's host in REPLAYBOOK_ALLOWED_HOSTS when air-gapped.
# TICKET_RAG_URL=https://ticket-search.internal/mcp
# TICKET_RAG_TOKEN=
# TICKET_RAG_DATA=data/generated     # the dataset the example server in examples/ticket_rag searches

# Air-gapped mode: refuse every outbound connection and name lookup except the hosts
# listed (host or host:port, comma-separated). The Docker image sets this to true.
# Listening is always allowed; add 127.0.0.1 when an agent in this process must reach the
# HTTP doors (mock-server --http, tool-endpoint).
# REPLAYBOOK_AIRGAPPED=true
# REPLAYBOOK_ALLOWED_HOSTS=ollama:11434

# After go-live (replaybook live record / report / check): where live runs are kept, how
# many of each skill's latest runs the rolling rates cover, and the rates below which a
# skill is flagged degraded.
REPLAYBOOK_LIVE_DIR=live
REPLAYBOOK_LIVE_WINDOW=30
REPLAYBOOK_MIN_APPROVAL_RATE=0.8
REPLAYBOOK_MIN_VERIFICATION_RATE=0.95
